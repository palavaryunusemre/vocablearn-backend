# docker-compose.yml bu dosyayı ".env" adıyla aynı klasörden otomatik okur.
# Kopyala:  cp .env.example .env   (sonra gerçek değerleri doldur)
# ".env" dosyası .gitignore'dadır -- asla commit etme.

# Groq (OpenAI-uyumlu) API anahtarı -- /api/chat (yapay zeka asistanı) için.
GROQ_API_KEY=

# JWT imzalama anahtarı -- en az 32 byte, rastgele bir metin.
# Üretmek için: openssl rand -base64 48
JWT_SECRET=
